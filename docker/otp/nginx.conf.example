# Place inside your existing TLS-enabled server block. Provision your own certificate.
# Only the server-to-server OTP API and signed Meta webhook are public.
# Admin console and WhatsApp manager remain accessible over an SSH tunnel.
location /v1/otp/ {
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
}
location = /otp/webhooks/meta {
    client_max_body_size 1m;
    access_log off; # Meta verification query contains a secret token.
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
}
location /otp { return 404; }
location / { return 404; }
